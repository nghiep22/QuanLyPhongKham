NODE_ENV=development
LOG_LEVEL=debug

GATEWAY_PORT=5000
AUTH_SERVICE_PORT=4001
WEB_ALLOWED_ORIGINS=http://localhost:5173
CLINIC_SERVICE_PORT=4002
SCHEDULER_WORKER_PORT=4010

SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=PrivateClinicManagement
SQL_TRUSTED_CONNECTION=true
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_CONNECTION_TIMEOUT_MS=5000
SQL_REQUEST_TIMEOUT_MS=5000
SQL_USER=
SQL_PASSWORD=

JWT_ISSUER=private-clinic-auth
JWT_AUDIENCE=private-clinic-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
JWT_COOKIE_NAME=clinic_refresh_token
JWT_COOKIE_SECURE=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_PER_HOUR=3
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_DELIVERY_MODE=console
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_BEARER_TOKEN=
PATIENT_REGISTRATION_BRANCH_CODE=MAIN
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_REQUESTS_PER_HOUR=3
AUTH_OTP_HASH_SECRET=replace-with-at-least-32-random-characters
AUTH_OTP_DELIVERY_MODE=console
AUTH_OTP_WEBHOOK_URL=
AUTH_OTP_WEBHOOK_BEARER_TOKEN=
PATIENT_LINK_REQUEST_TTL_DAYS=7
PATIENT_LINK_MAX_REQUESTS_PER_DAY=5

VITE_API_BASE_URL=http://localhost:5000/api/v1
